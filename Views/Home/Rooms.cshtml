@{
    ViewData["Title"] = L["rm_title"].Value;
    ViewData["Description"] = L["rm_meta"].Value;
}

<section class="page-hero compact-hero">
    <div class="container">
        <p class="eyebrow">@L["rm_eyebrow"]</p>
        <h1>@L["rm_h1"]</h1>
        <p>@L["rm_copy"]</p>
    </div>
</section>

<section class="section" id="rooms">
    <div class="container room-card-grid">
        <article class="room-detail-card">
            <figure class="room-detail-image media-frame">
                <img src="/images/rooms/bungalov1.jpg" alt="Sunmed Lodge Bungalov oda ana fotoğrafı" onerror="this.style.display='none'" />
            </figure>
            <div class="room-detail-content">
                <p class="room-capacity">@L["rm_bung_capacity"]</p>
                <h2>@L["rm_bung_title"]</h2>
                <p>@L["rm_bung_desc"]</p>
                <div class="icon-feature-grid">
                    <span><i>AC</i>@L["rm_feat_ac"]</span>
                    <span><i>MB</i>@L["rm_feat_mb"]</span>
                    <span><i>OB</i>@L["rm_feat_bath"]</span>
                    <span><i>WF</i>@L["rm_feat_wifi"]</span>
                    <span><i>TV</i>@L["rm_feat_tv"]</span>
                </div>
                <div class="room-photo-strip" aria-label="Bungalov oda fotoğrafları">
                    <a href="#bungalov-1"><img src="/images/rooms/bungalov1.jpg" alt="Bungalov oda fotoğrafı 1" onerror="this.style.display='none'" /></a>
                    <a href="#bungalov-2"><img src="/images/rooms/bungalov2.jpg" alt="Bungalov oda fotoğrafı 2" onerror="this.style.display='none'" /></a>
                    <a href="#bungalov-3"><img src="/images/rooms/bungalov3.jpg" alt="Bungalov oda fotoğrafı 3" onerror="this.style.display='none'" /></a>
                    <a href="#bungalov-4"><img src="/images/rooms/bungalov4.jpg" alt="Bungalov oda fotoğrafı 4" onerror="this.style.display='none'" /></a>
                    <a href="#bungalov-5"><img src="/images/rooms/bungalov5.avif" alt="Bungalov oda fotoğrafı 5" onerror="this.style.display='none'" /></a>
                    <a href="#bungalov-6"><img src="/images/rooms/bungalov6.avif" alt="Bungalov oda fotoğrafı 6" onerror="this.style.display='none'" /></a>
                </div>
                <a class="btn btn-primary" href="https://wa.me/905307635826?text=Merhaba%2C%20Sunmed%20Lodge%20Bungalov%20odas%C4%B1%20hakk%C4%B1nda%20bilgi%20almak%20istiyorum." target="_blank" rel="noopener">@L["rm_btn"]</a>
            </div>
        </article>

        <article class="room-detail-card">
            <figure class="room-detail-image media-frame">
                <img src="/images/rooms/deluxe1.jpg" alt="Sunmed Lodge Deluxe Üç Kişilik Oda ana fotoğrafı" onerror="this.style.display='none'" />
            </figure>
            <div class="room-detail-content">
                <p class="room-capacity">@L["rm_dlx_capacity"]</p>
                <h2>@L["rm_dlx_title"]</h2>
                <p>@L["rm_dlx_desc"]</p>
                <div class="icon-feature-grid">
                    <span><i>AC</i>@L["rm_feat_ac"]</span>
                    <span><i>MB</i>@L["rm_feat_mb"]</span>
                    <span><i>OB</i>@L["rm_feat_bath"]</span>
                    <span><i>WF</i>@L["rm_feat_wifi"]</span>
                    <span><i>TV</i>@L["rm_feat_tv"]</span>
                </div>
                <div class="room-photo-strip" aria-label="Deluxe Üç Kişilik Oda fotoğrafları">
                    <a href="#deluxe-1"><img src="/images/rooms/deluxe1.jpg" alt="Deluxe Üç Kişilik Oda fotoğrafı 1" onerror="this.style.display='none'" /></a>
                    <a href="#deluxe-2"><img src="/images/rooms/deluxe2.jpg" alt="Deluxe Üç Kişilik Oda fotoğrafı 2" onerror="this.style.display='none'" /></a>
                    <a href="#deluxe-3"><img src="/images/rooms/deluxe3.avif" alt="Deluxe Üç Kişilik Oda fotoğrafı 3" onerror="this.style.display='none'" /></a>
                    <a href="#deluxe-4"><img src="/images/rooms/deluxe4.avif" alt="Deluxe Üç Kişilik Oda fotoğrafı 4" onerror="this.style.display='none'" /></a>
                    <a href="#deluxe-5"><img src="/images/rooms/deluxe5.avif" alt="Deluxe Üç Kişilik Oda fotoğrafı 5" onerror="this.style.display='none'" /></a>
                    <a href="#deluxe-6"><img src="/images/rooms/deluxe6.avif" alt="Deluxe Üç Kişilik Oda fotoğrafı 6" onerror="this.style.display='none'" /></a>
                </div>
                <a class="btn btn-primary" href="https://wa.me/905307635826?text=Merhaba%2C%20Sunmed%20Lodge%20Deluxe%20%C3%9C%C3%A7%20Ki%C5%9Filik%20Oda%20hakk%C4%B1nda%20bilgi%20almak%20istiyorum." target="_blank" rel="noopener">@L["rm_btn"]</a>
            </div>
        </article>
    </div>
</section>

@{
    var bungalovPhotos = new[]
    {
        "/images/rooms/bungalov1.jpg",
        "/images/rooms/bungalov2.jpg",
        "/images/rooms/bungalov3.jpg",
        "/images/rooms/bungalov4.jpg",
        "/images/rooms/bungalov5.avif",
        "/images/rooms/bungalov6.avif"
    };

    var deluxePhotos = new[]
    {
        "/images/rooms/deluxe1.jpg",
        "/images/rooms/deluxe2.jpg",
        "/images/rooms/deluxe3.avif",
        "/images/rooms/deluxe4.avif",
        "/images/rooms/deluxe5.avif",
        "/images/rooms/deluxe6.avif"
    };
}

@for (var i = 0; i < bungalovPhotos.Length; i++)
{
    var number = i + 1;
    var previous = i == 0 ? bungalovPhotos.Length : i;
    var next = i == bungalovPhotos.Length - 1 ? 1 : number + 1;
    <div class="lightbox" id="bungalov-@number">
        <a class="lightbox-backdrop" href="#rooms" aria-label="Fotoğrafı kapat"></a>
        <div class="lightbox-dialog">
            <a class="lightbox-close" href="#rooms" aria-label="Fotoğrafı kapat">@L["rm_close"]</a>
            <a class="lightbox-arrow lightbox-prev" href="#bungalov-@previous" aria-label="Önceki">‹</a>
            <a class="lightbox-arrow lightbox-next" href="#bungalov-@next" aria-label="Sonraki">›</a>
            <img src="@bungalovPhotos[i]" alt="Bungalov oda büyük fotoğraf @number" />
        </div>
    </div>
}

@for (var i = 0; i < deluxePhotos.Length; i++)
{
    var number = i + 1;
    var previous = i == 0 ? deluxePhotos.Length : i;
    var next = i == deluxePhotos.Length - 1 ? 1 : number + 1;
    <div class="lightbox" id="deluxe-@number">
        <a class="lightbox-backdrop" href="#rooms" aria-label="Fotoğrafı kapat"></a>
        <div class="lightbox-dialog">
            <a class="lightbox-close" href="#rooms" aria-label="Fotoğrafı kapat">@L["rm_close"]</a>
            <a class="lightbox-arrow lightbox-prev" href="#deluxe-@previous" aria-label="Önceki">‹</a>
            <a class="lightbox-arrow lightbox-next" href="#deluxe-@next" aria-label="Sonraki">›</a>
            <img src="@deluxePhotos[i]" alt="Deluxe Üç Kişilik Oda büyük fotoğraf @number" />
        </div>
    </div>
}
