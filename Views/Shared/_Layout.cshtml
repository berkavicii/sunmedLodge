@{
    var pageTitle = ViewData["Title"]?.ToString() ?? "Sunmed Lodge";
    var pageDescription = ViewData["Description"]?.ToString() ?? "Sunmed Lodge, Ölüdeniz Fethiye'de 14 odalı, bahçeli ve sakin Akdeniz butik oteli.";
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = Context.Request.Path.ToString();
}
<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@pageDescription" />
    <meta property="og:title" content="@pageTitle - Sunmed Lodge" />
    <meta property="og:description" content="@pageDescription" />
    <meta property="og:type" content="website" />
    <title>@pageTitle - Sunmed Lodge</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Nunito+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SunmedLodge.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="site-nav" aria-label="Ana menü">
            <div class="container nav-shell">
                <a class="brand-mark" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Sunmed Lodge anasayfa">
                    <img src="/images/hero/sunmedlogo-header.png" alt="Sunmed Lodge" />
                </a>
                <button class="menu-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Menüyü aç veya kapat">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
                <div class="nav-collapse collapse" id="mainNavigation">
                    <ul class="nav-list">
                        <li><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">@L["nav_home"]</a></li>
                        <li><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Rooms">@L["nav_rooms"]</a></li>
                        <li><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Gallery">@L["nav_gallery"]</a></li>
                        <li><a class="nav-link" asp-area="" asp-controller="Home" asp-action="About">@L["nav_about"]</a></li>
                        <li><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Contact">@L["nav_contact"]</a></li>
                        <li class="lang-item">
                            <div class="lang-switch">
                                <a href="@Url.Action("SetLanguage", "Home", new { culture = "tr", returnUrl })"
                                   class="lang-btn @(currentCulture == "tr" ? "is-active" : "")"
                                   aria-label="Türkçe">TR</a>
                                <span class="lang-sep">|</span>
                                <a href="@Url.Action("SetLanguage", "Home", new { culture = "en", returnUrl })"
                                   class="lang-btn @(currentCulture == "en" ? "is-active" : "")"
                                   aria-label="English">EN</a>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-shell">
            <div>
                <a class="footer-brand" asp-controller="Home" asp-action="Index">Sunmed Lodge</a>
                <p>Belceğiz Mahallesi, 235. Sokak, Fethiye, Muğla, 48300</p>
            </div>
            <div class="footer-links" aria-label="İletişim bağlantıları">
                <a href="tel:+90XXXXXXXXXX">@L["footer_call"]</a>
                <a href="https://wa.me/90XXXXXXXXXX?text=Merhaba%2C%20Sunmed%20Lodge%20hakk%C4%B1nda%20bilgi%20almak%20istiyorum." target="_blank" rel="noopener">WhatsApp</a>
                <a href="https://maps.app.goo.gl/GqsjMxA7zf15hrpK8" target="_blank" rel="noopener">@L["footer_location"]</a>
            </div>
        </div>
    </footer>

    <a class="floating-whatsapp" href="https://wa.me/90XXXXXXXXXX?text=Merhaba%2C%20Sunmed%20Lodge%20hakk%C4%B1nda%20bilgi%20almak%20istiyorum." target="_blank" rel="noopener" aria-label="Sunmed Lodge WhatsApp ile iletişim">
        <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
            <path d="M16.03 3.2c-7.05 0-12.78 5.68-12.78 12.68 0 2.24.6 4.42 1.73 6.34L3.2 28.8l6.75-1.76a12.9 12.9 0 0 0 6.08 1.53c7.05 0 12.78-5.69 12.78-12.69S23.08 3.2 16.03 3.2Zm0 23.22c-1.92 0-3.8-.51-5.44-1.47l-.39-.23-4 .99 1.08-3.85-.25-.4a10.36 10.36 0 0 1-1.62-5.58c0-5.8 4.76-10.53 10.62-10.53 5.85 0 10.62 4.72 10.62 10.53 0 5.8-4.77 10.54-10.62 10.54Zm5.82-7.9c-.32-.16-1.9-.93-2.2-1.04-.29-.1-.5-.16-.72.16-.21.32-.82 1.04-1 1.25-.19.21-.37.24-.69.08-.32-.16-1.35-.49-2.57-1.58-.95-.84-1.6-1.88-1.78-2.2-.19-.32-.02-.49.14-.65.14-.14.32-.37.48-.56.16-.18.21-.32.32-.53.1-.21.05-.4-.03-.56-.08-.16-.72-1.72-.98-2.36-.26-.62-.52-.54-.72-.55h-.61c-.21 0-.56.08-.85.4-.3.32-1.12 1.1-1.12 2.67s1.15 3.09 1.31 3.3c.16.21 2.26 3.43 5.47 4.81.76.33 1.36.53 1.82.68.77.24 1.47.21 2.02.13.62-.09 1.9-.77 2.17-1.52.27-.75.27-1.39.19-1.52-.08-.13-.29-.21-.61-.37Z" />
        </svg>
        <span>WhatsApp</span>
    </a>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
